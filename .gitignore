# OS files
.DS_Store
Thumbs.db

# Editor and local tooling
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/
.codex/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.*
!.env.example
docker/env/*.env
!docker/env/*.env.example
*.local

# Node
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/

# PHP / Laravel
vendor/
auth.json
.phpactor.json
.phpunit.result.cache
.phpunit.cache/
_ide_helper.php
Homestead.json
Homestead.yaml

# Laravel generated files
public/build/
public/fonts-manifest.dev.json
public/hot
public/storage
storage/*.key
storage/pail/
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

# Databases
*.sqlite
*.sqlite-*
*.sqlite3
*.db

# Ignore nested project build/artifact directories and secrets
backend/.env
backend/vendor/
backend/node_modules/
backend/.phpunit.result.cache
# ignore most of backend storage but allow specific public demo files (see negations below)
backend/storage/*

!backend/storage/
!backend/storage/app/
!backend/storage/app/public/
backend/public/storage/

frontend/node_modules/
frontend/dist/
frontend/.env

# Ignore macOS DS_Store anywhere
**/.DS_Store

# Ignore common media and cache files that sometimes get accidentally added
# (narrow scope: backend storage/media)
backend/storage/app/public/*

# Allow committing demo videos used for offline/demo purposes
!backend/storage/app/public/demo-videos/
!backend/storage/app/public/demo-videos/*
