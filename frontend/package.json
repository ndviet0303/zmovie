{
  "name": "zmovie",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "nuxt dev",
    "cf-typegen": "wrangler types",
    "gen:openapi": "npm run generate:api",
    "generate:api": "curl --fail --location --silent --show-error --insecure ${OPENAPI_URL:-http://localhost:5275/openapi/v1.json} -o /tmp/zmovie-openapi.json && openapi-typescript /tmp/zmovie-openapi.json -o app/types/api.d.ts",
    "generate": "nuxt generate",
    "preview": "npm run build && wrangler dev",
    "preview:nuxt": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/patch-nitro.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "nuxt": "^4.5.0",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "wrangler": "^4.113.0"
  }
}
